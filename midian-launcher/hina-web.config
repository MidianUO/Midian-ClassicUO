<?xml version="1.0" encoding="utf-8"?>
<!-- C:\Midian-Web\hina\web.config sul VPS: IIS serve l'elenco e i pezzi di Hina (pubblica-hina.ps1).
     I pezzi (.chunk.br) sono gia' compressi da Hina: vanno spediti cosi' come sono, senza Content-Encoding. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".br" />
      <mimeMap fileExtension=".br" mimeType="application/octet-stream" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
